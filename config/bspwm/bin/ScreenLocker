#!/bin/sh
# =============================================================
# ScreenLocker - i3lock-color com relógio centralizado e anel fino
#   ScreenLocker      → fundo: print da tela borrado e escurecido
#   ScreenLocker -r   → fundo: wallpaper do tema borrado e escurecido
# As cores abaixo são geradas pelo módulo 07-screenlocker.sh (theme.bash).
# =============================================================

TEMP_IMAGE="/tmp/i3lock.png"
TEMP_LAYOUT="/tmp/lockerpreviouskeymap"

# Colors
bg=#0b1530
fg=#e8ecf5
ring=#e4002b
wrong=#e4002b
date=#e8ecf5
verify=#ffc72c

save_current_keymap() {
    setxkbmap -query | awk '/^layout:/ {print $2}' > "$TEMP_LAYOUT"
    setxkbmap -query | awk '/^options:/ {print $2}' > "${TEMP_LAYOUT}_options"
}

restore_previous_keymap() {
    [ -f "$TEMP_LAYOUT" ] || return
    previous_layout=$(cat "$TEMP_LAYOUT")
    previous_options=$(cat "${TEMP_LAYOUT}_options" 2>/dev/null)
    if [ -n "$previous_options" ]; then
        setxkbmap -layout "$previous_layout" -option "$previous_options"
    else
        setxkbmap -layout "$previous_layout"
    fi
    rm -f "$TEMP_LAYOUT" "${TEMP_LAYOUT}_options"
}

get_screen_resolution() {
    resolution=$(xrandr | awk '/\*/ {print $1; exit}')
    [ -n "$resolution" ] || resolution="1920x1080"
    SCREEN_WIDTH=${resolution%x*}
    SCREEN_HEIGHT=${resolution#*x}
}

# Sizes scale with the screen (base: 1920x1080)
calculate_layout() {
    scale=$(echo "scale=2; sqrt(($SCREEN_WIDTH * $SCREEN_HEIGHT) / (1920 * 1080))" | bc)
    [ -n "$scale" ] || scale=1
    px() { echo "$1 * $scale" | bc | cut -d. -f1; }

    TIME_SIZE=$(px 120)
    DATE_SIZE=$(px 26)
    TEXT_SIZE=$(px 18)
    RADIUS=$(px 60)
    RING_WIDTH=$(px 6)

    CENTER_X=$((SCREEN_WIDTH / 2))
    TIME_Y=$((SCREEN_HEIGHT * 40 / 100))
    DATE_Y=$((SCREEN_HEIGHT * 46 / 100))
    IND_Y=$((SCREEN_HEIGHT * 62 / 100))
    MSG_Y=$((SCREEN_HEIGHT * 76 / 100))
}

# Blur and tint an image with the theme background
prepare_image() {
    magick "$1" -resize "${SCREEN_WIDTH}x${SCREEN_HEIGHT}^" -gravity center \
        -extent "${SCREEN_WIDTH}x${SCREEN_HEIGHT}" \
        -scale 25% -blur 0x6 -scale 400% \
        -fill "$bg" -colorize 45% "$TEMP_IMAGE"
}

lock() {
    i3lock -n --force-clock -i "$TEMP_IMAGE" -e --indicator \
        --radius="$RADIUS" --ring-width="$RING_WIDTH" \
        --inside-color="${bg#\#}88" --ring-color="${ring#\#}" \
        --insidever-color="${bg#\#}88" --ringver-color="${verify#\#}" \
        --insidewrong-color="${bg#\#}88" --ringwrong-color="${wrong#\#}" \
        --line-color=00000000 --separator-color=00000000 \
        --keyhl-color="${verify#\#}" --bshl-color="${fg#\#}" \
        --time-str="%H:%M" --date-str="%A, %d de %B" \
        --time-font="JetBrainsMono NF:style=Bold" --date-font="JetBrainsMono NF" \
        --verif-font="JetBrainsMono NF" --wrong-font="JetBrainsMono NF" --greeter-font="JetBrainsMono NF" \
        --time-size="$TIME_SIZE" --date-size="$DATE_SIZE" \
        --verif-size="$TEXT_SIZE" --wrong-size="$TEXT_SIZE" --greeter-size="$TEXT_SIZE" \
        --time-color="${fg#\#}" --date-color="${date#\#}" \
        --verif-color="${verify#\#}" --wrong-color="${wrong#\#}" --greeter-color="${fg#\#}" \
        --verif-text="Verificando..." --wrong-text="Senha incorreta" --noinput-text="" \
        --greeter-text="Digite a senha para desbloquear" \
        --time-pos="$CENTER_X:$TIME_Y" --date-pos="$CENTER_X:$DATE_Y" \
        --ind-pos="$CENTER_X:$IND_Y" --greeter-pos="$CENTER_X:$MSG_Y" \
        --verif-pos="$CENTER_X:$MSG_Y" --wrong-pos="$CENTER_X:$MSG_Y" \
        --pointer=default --refresh-rate=0 \
        --pass-media-keys --pass-volume-keys
}

run() {
    save_current_keymap
    setxkbmap -layout us
    get_screen_resolution
    calculate_layout
    prepare_image "$1" || exit 1
    lock
    restore_previous_keymap
}

case $1 in
    -r|--rice)
        wall=$(find "$HOME/.config/bspwm/walls" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) | shuf -n 1)
        run "$wall"
        ;;
    -h|--help)
        printf 'ScreenLocker [-r|--rice]\n  sem opção: print da tela borrado\n  -r: wallpaper do tema borrado\n'
        ;;
    *)
        maim -d 0.3 -u /tmp/i3lock-shot.png
        run /tmp/i3lock-shot.png
        rm -f /tmp/i3lock-shot.png
        ;;
esac
